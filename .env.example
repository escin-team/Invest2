# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DOKU Payment Gateway (Server-only credentials; set real Sandbox/Production keys via .env or Secrets panel)
# DOKU_ENVIRONMENT: "sandbox" untuk testing, "production" untuk transaksi live (default: sandbox)
DOKU_ENVIRONMENT="sandbox"
DOKU_MERCHANT_ID="MY_DOKU_MERCHANT_ID"
DOKU_SECRET_KEY="MY_DOKU_SECRET_KEY"
DOKU_PUBLIC_KEY="MY_DOKU_PUBLIC_KEY"

# SMTP Email Server (Server-only credentials untuk pengiriman OTP Daftar, Lupa Password, & Tes Email)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_ENCRYPTION="starttls"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Nature Republic Investasi"
SMTP_FROM_EMAIL=""
